    "affidavit": "node scripts/make-affidavit.mjs",
    "logos": "node scripts/make-logos.mjs",
    "images": "node scripts/process-images.mjs"
  },
  "devDependencies": {
    "@fontsource/oxanium": "5.0.0",
    "opentype.js": "1.3.4",
    "sharp": "0.33.5"
  }
}
