{
  "name": "seudocom-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Seudocom static website. Node is only needed on a developer machine, never on the server.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
